{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snow0821-github-io",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-13",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/workspace", "/workspace/*", "/private", "/private/*", "/api", "/api/*"]
  },
  "workers_dev": true,
  "preview_urls": true
}
